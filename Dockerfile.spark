FROM apache/spark-py:v3.3.1

USER root

ARG DELTA_VERSION=2.2.0
ARG HADOOP_AWS_VERSION=3.3.2
ARG AWS_SDK_BUNDLE_VERSION=1.11.1026

RUN python3 -c 'import os, urllib.request; \
base="https://repo1.maven.org/maven2"; \
delta=os.environ["DELTA_VERSION"]; \
hadoop=os.environ["HADOOP_AWS_VERSION"]; \
aws=os.environ["AWS_SDK_BUNDLE_VERSION"]; \
files=[ \
(f"{base}/io/delta/delta-core_2.12/{delta}/delta-core_2.12-{delta}.jar", f"/opt/spark/jars/delta-core_2.12-{delta}.jar"), \
(f"{base}/io/delta/delta-storage/{delta}/delta-storage-{delta}.jar", f"/opt/spark/jars/delta-storage-{delta}.jar"), \
(f"{base}/org/apache/hadoop/hadoop-aws/{hadoop}/hadoop-aws-{hadoop}.jar", f"/opt/spark/jars/hadoop-aws-{hadoop}.jar"), \
(f"{base}/com/amazonaws/aws-java-sdk-bundle/{aws}/aws-java-sdk-bundle-{aws}.jar", f"/opt/spark/jars/aws-java-sdk-bundle-{aws}.jar")]; \
[urllib.request.urlretrieve(url, path) for url, path in files]'

WORKDIR /opt/spark/work-dir

COPY requirements-spark.txt /opt/spark/work-dir/requirements-spark.txt
RUN pip install --no-cache-dir -r /opt/spark/work-dir/requirements-spark.txt

COPY jobs/ /opt/spark/work-dir/jobs/
COPY config/ /opt/spark/work-dir/config/
COPY data/sample/ /opt/spark/work-dir/data/sample/

ENV PYTHONPATH=/opt/spark/work-dir
ENV SPARK_IMAGE_ROLE=PROCESSING

LABEL org.opencontainers.image.title="Data Master Spark Jobs" \
      org.opencontainers.image.description="Spark processing runtime with Delta Lake and S3A dependencies" \
      org.opencontainers.image.source="https://github.com/ale468/Data-Master-Platform" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      io.data-master.image-role="processing"

USER 185
