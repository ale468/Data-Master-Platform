ARG SPARK_BASE_IMAGE=data-master-spark-jobs:build-required
FROM ${SPARK_BASE_IMAGE}

USER root

COPY requirements-jupyter.txt /opt/spark/work-dir/requirements-jupyter.txt
RUN pip install --no-cache-dir -r /opt/spark/work-dir/requirements-jupyter.txt

ENV PYTHONPATH=/opt/spark/work-dir \
    JUPYTER_IMAGE_ROLE=PRESENTATION_READ_ONLY \
    JUPYTER_PORT=8888 \
    JUPYTER_ROOT_DIR=/opt/spark/work-dir/jobs/presentation/notebooks \
    HOME=/tmp \
    JUPYTER_CONFIG_DIR=/tmp/.jupyter \
    JUPYTER_DATA_DIR=/tmp/.local/share/jupyter \
    JUPYTER_RUNTIME_DIR=/tmp/jupyter-runtime \
    SPARK_USER=nobody

LABEL org.opencontainers.image.title="Data Master Jupyter" \
      org.opencontainers.image.description="Read-only presentation runtime over the Data Master Spark and Delta image" \
      org.opencontainers.image.source="https://github.com/ale468/Data-Master-Platform" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      io.data-master.image-role="presentation-read-only"

# The MinIO identity remains read-only, but the notebook workspace must be
# writable by the non-root Jupyter process so users can upload and save .ipynb
# files during a presentation.
RUN chown -R 65534:65534 "${JUPYTER_ROOT_DIR}" \
    && chmod -R u+rwX,go-rwx "${JUPYTER_ROOT_DIR}"

USER 65534:65534
RUN test -w "${JUPYTER_ROOT_DIR}"
WORKDIR /opt/spark/work-dir/jobs/presentation/notebooks

EXPOSE 8888

CMD ["/bin/sh", "/opt/spark/work-dir/jobs/presentation/start_jupyter.sh"]
