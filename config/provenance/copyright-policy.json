  "review_required_patterns": [
    {
      "pattern": "infra/**",
      "reason": "Operational manifests, templates and commands may contain upstream scaffolding or documentation-derived material."
    },
    {
      "pattern": "data/**",
      "reason": "Synthetic data is generated content and is not classified as project source code."
    },
    {
      "pattern": "tests/evidence/**",
      "reason": "Committed runtime evidence is generated output."
    }
  ],
  "files_without_project_copyright": [
    "CODE_OF_CONDUCT.md",
    "LICENSE",
