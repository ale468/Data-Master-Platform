    "infra/helm-charts/airflow/templates/_helpers.tpl",
    "infra/helm-charts/hive-metastore/templates/_helpers.tpl",
    "infra/helm-charts/jupyter/templates/_helpers.tpl",
    "infra/helm-charts/minio/templates/_helpers.tpl",
